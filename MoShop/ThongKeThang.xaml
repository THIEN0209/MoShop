<Window x:Class="MoShop.ThongKeThang"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoShop"
        xmlns:localmodels="clr-namespace:MoShop.Models"
        mc:Ignorable="d"
        Title="Thống kê tháng"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Loaded="Window_Loaded">

    <Grid Margin="25" Background="#FFF5F7">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0"
               Text="THỐNG KÊ THU CHI THEO THÁNG"
               FontSize="26"
               FontWeight="Bold"
               Foreground="#D6708C"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <!-- KHU VỰC CHỌN THÁNG -->
        <Border Grid.Row="1"
            Background="White"
            CornerRadius="12"
            Padding="15"
            Margin="0,0,0,15"
            BorderBrush="#F8D7E0"
            BorderThickness="1">

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

                <TextBlock Text="Tháng:"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#5A4A4E"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                <ComboBox x:Name="cboThang"
                      Width="100"
                      Height="35"
                      FontSize="15"
                      VerticalContentAlignment="Center"
                      Margin="0,0,25,0"/>

                <TextBlock Text="Năm:"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#5A4A4E"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                <ComboBox x:Name="cboNam"
                      Width="120"
                      Height="35"
                      FontSize="15"
                      VerticalContentAlignment="Center"/>

                <Button Content="Lọc"
                    Width="90"
                    Height="35"
                    Margin="25,0,0,0"
                    Background="#F49AB1"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnLoc_Click"/>
            </StackPanel>

        </Border>

        <!-- BẢNG THỐNG KÊ -->
        <Border Grid.Row="2"
            Background="White"
            CornerRadius="12"
            Padding="10"
            BorderBrush="#F8D7E0"
            BorderThickness="1">

            <DataGrid x:Name="dtgThongKe"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  FontSize="15"
                  RowHeight="42"
                  ColumnHeaderHeight="45"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#FFF9FB"
                  HorizontalGridLinesBrush="#F3E1E6"
                  VerticalGridLinesBrush="Transparent"
                  HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                            Value="#F49AB1"/>
                        <Setter Property="Foreground"
                            Value="White"/>
                        <Setter Property="FontWeight"
                            Value="Bold"/>
                        <Setter Property="FontSize"
                            Value="15"/>
                        <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>
                        <Setter Property="Padding"
                            Value="10"/>
                        <Setter Property="BorderThickness"
                            Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CANH GIỮA MẶC ĐỊNH CHO MỌI CELL, ĐỂ DỮ LIỆU THẲNG HÀNG VỚI HEADER -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="#5A4A4E"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FCE4EC"/>
                                <Setter Property="Foreground" Value="#5A4A4E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- NGÀY -->
                    <DataGridTextColumn Header="Ngày"
                                    Binding="{Binding Ngay}"
                                    Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- TỔNG THU -->
                    <DataGridTextColumn Header="Tổng thu"
                                    Binding="{Binding TongThuHienThi}"
                                    Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#4CAF7D"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- TỔNG CHI -->
                    <DataGridTextColumn Header="Tổng chi"
                                    Binding="{Binding TongChiHienThi}"
                                    Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#E05285"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- DOANH THU -->
                    <DataGridTextColumn Header="Doanh thu"
                                    Binding="{Binding DoanhThuHienThi}"
                                    Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#5A4A4E"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- TỔNG KẾT -->
        <Border Grid.Row="3"
            Background="#F49AB1"
            CornerRadius="12"
            Margin="0,15,0,0"
            Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TỔNG THU -->
                <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">

                    <TextBlock Text="TỔNG THU"
                           Foreground="#FFF0F4"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtTongThu"
                           Text="0 đ"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- TỔNG CHI -->
                <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center">

                    <TextBlock Text="TỔNG CHI"
                           Foreground="#FFF0F4"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtTongChi"
                           Text="0 đ"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- DOANH THU -->
                <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center">

                    <TextBlock Text="DOANH THU"
                           Foreground="#FFF0F4"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtDoanhThu"
                           Text="0 đ"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>


</Window>