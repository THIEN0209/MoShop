<Window x:Class="MoShop.DoanhSo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoShop"
        xmlns:localmodes="clr-namespace:MoShop.Models"
        mc:Ignorable="d"
        Title="Doanh số"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F1F8F9"
        Loaded="Window_Loaded">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================= TIÊU ĐỀ ================= -->

        <StackPanel Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">

            <TextBlock Text="THỐNG KÊ DOANH SỐ"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#397B80"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="Theo dõi tình hình thu chi và doanh thu trong năm"
                   FontSize="14"
                   Foreground="#6B8588"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ================= CHỌN NĂM ================= -->

        <Border Grid.Row="1"
            Background="White"
            CornerRadius="12"
            Padding="18"
            Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

                <TextBlock Text="Năm:"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#426568"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                <ComboBox x:Name="cboNam"
                      Width="130"
                      Height="38"
                      FontSize="15"
                      VerticalContentAlignment="Center"/>

                <Button x:Name="btnXem"
                    Content="Xem thống kê"
                    Width="130"
                    Height="38"
                    Margin="20,0,0,0"
                    Background="#8CCFD3"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnXem_Click"/>

            </StackPanel>

        </Border>


        <!-- ================= BẢNG THỐNG KÊ ================= -->

        <Border Grid.Row="2"
            Background="White"
            CornerRadius="12"
            Padding="10">

            <DataGrid x:Name="dtgDoanhSo"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  FontSize="15"
                  RowHeight="42"
                  ColumnHeaderHeight="48"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F3FBFB"
                  HorizontalGridLinesBrush="#E3EEEE"
                  VerticalGridLinesBrush="Transparent"
                  HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

                <!-- HEADER -->

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                            Value="#8CCFD3"/>

                        <Setter Property="Foreground"
                            Value="White"/>

                        <Setter Property="FontWeight"
                            Value="Bold"/>

                        <Setter Property="FontSize"
                            Value="15"/>

                        <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                        <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                        <Setter Property="Padding"
                            Value="10"/>

                        <Setter Property="BorderThickness"
                            Value="0"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>


                <!-- CANH GIỮA MẶC ĐỊNH CHO MỌI CELL, TRÁNH LỆCH VỚI HEADER -->

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D7F0F1"/>
                                <Setter Property="Foreground" Value="#397B80"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>


                <!-- CÁC CỘT -->

                <DataGrid.Columns>

                    <!-- THÁNG -->

                    <DataGridTextColumn Header="Tháng"
                                    Binding="{Binding Thang}"
                                    Width="*">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                                <Setter Property="TextAlignment"
                                    Value="Center"/>

                                <Setter Property="VerticalAlignment"
                                    Value="Center"/>

                                <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                                <Setter Property="Foreground"
                                    Value="#426568"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- TỔNG THU -->

                    <DataGridTextColumn Header="Tổng thu"
                                    Binding="{Binding TongThuHienThi}"
                                    Width="2*">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Right"/>

                                <Setter Property="TextAlignment"
                                    Value="Right"/>

                                <Setter Property="Margin"
                                    Value="0,0,15,0"/>

                                <Setter Property="Foreground"
                                    Value="#2E9E6B"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- TỔNG CHI -->

                    <DataGridTextColumn Header="Tổng chi"
                                    Binding="{Binding TongChiHienThi}"
                                    Width="2*">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Right"/>

                                <Setter Property="TextAlignment"
                                    Value="Right"/>

                                <Setter Property="Margin"
                                    Value="0,0,15,0"/>

                                <Setter Property="Foreground"
                                    Value="#E05252"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- DOANH THU -->

                    <DataGridTextColumn Header="Doanh thu"
                                    Binding="{Binding DoanhThuHienThi}"
                                    Width="2*">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Right"/>

                                <Setter Property="TextAlignment"
                                    Value="Right"/>

                                <Setter Property="Margin"
                                    Value="0,0,15,0"/>

                                <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                                <Setter Property="Foreground"
                                    Value="#397B80"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- ================= TỔNG KẾT ================= -->

        <Border Grid.Row="3"
            Background="#D7F0F1"
            CornerRadius="12"
            Margin="0,15,0,0"
            Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TỔNG THU -->

                <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">

                    <TextBlock Text="TỔNG THU"
                           Foreground="#5E8588"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtTongThu"
                           Text="0 đ"
                           Foreground="#397B80"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- TỔNG CHI -->

                <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center">

                    <TextBlock Text="TỔNG CHI"
                           Foreground="#5E8588"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtTongChi"
                           Text="0 đ"
                           Foreground="#397B80"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- DOANH THU -->

                <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center">

                    <TextBlock Text="DOANH THU"
                           Foreground="#5E8588"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtDoanhThu"
                           Text="0 đ"
                           Foreground="#397B80"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>


</Window>